{
  "coverage_options": {
    "treat_no_relevant_lines_as_covered": true,
    "output_dir": "cover/",
    "minimum_coverage": 50
  },
  "skip_files": [
    "test/",
    "_build/",
    "deps/"
  ],
  "stop_words": [
    "defmodule",
    "defstruct",
    "end"
  ],
  "terminal_options": {
    "file_column_width": 40
  }
}
